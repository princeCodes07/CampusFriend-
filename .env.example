# Copy to .env for local development; Django loads .env automatically.
# Exported environment values take precedence. Keep real secrets out of this file.
DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CSRF_TRUSTED_ORIGINS=

# Staging: use DEBUG=False, the assigned hostname, and its HTTPS origin above.
# HTTPS production controls default on when DEBUG=False.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Leave blank unless the selected reverse proxy overwrites/sanitizes this header.
# Example only: HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=

# Public business details shown in the storefront footer when supplied.
BUSINESS_PHONE=0509109308
WHATSAPP_NUMBER=0509109308
BUSINESS_EMAIL=tankprince62@gmail.com

# Repairs email notifications (leave host/sender blank to keep delivery disabled).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Orders locations and fees are fixed in orders/delivery.py; no admin setup is required.
# Campus and Palms Eatery pickup are free. Other-location delivery is settled separately.
# Legacy CHECKOUT_DELIVERY_FEE values are ignored.

# Blank keeps local SQLite. On Render this is required and must be set privately.
# PostgreSQL URLs only. TLS defaults to sslmode=require; verify-full is supported.
# URL-encode special characters in credentials; never paste real URLs into Git/chat.
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Paystack hosted checkout. Use matching test keys for development.
# Live payments require PAYSTACK_LIVE_MODE=True and matching live keys.
# When live mode is enabled, test credentials are rejected.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_LIVE_MODE=False
# Dashboard target for staging; configure only after deploying a public HTTPS host.
PAYSTACK_WEBHOOK_URL=

CLOUDINARY_URL=
